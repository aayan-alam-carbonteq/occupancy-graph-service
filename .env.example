# Partner records DB. Never commit a filled-in copy of this file.
PARTNER_DSN=postgresql://USER:PASSWORD@HOST:5432/all_data?sslmode=require
# Per-statement ceiling. Phase-2 (property_owner) scans are the reason this exists.
PARTNER_STATEMENT_TIMEOUT_MS=20000
PARTNER_POOL_MIN=1
PARTNER_POOL_MAX=8
# Fixture DB used by the test suite.
TEST_DSN=postgresql://graph:graph@127.0.0.1:55432/graph_fixture

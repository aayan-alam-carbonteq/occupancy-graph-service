# Partner records DB. Never commit a filled-in copy of this file.
PARTNER_DSN=postgresql://USER:PASSWORD@HOST:5432/all_data?sslmode=require
# Per-statement ceiling. Phase-2 (property_owner) scans are the reason this exists.
PARTNER_STATEMENT_TIMEOUT_MS=20000
PARTNER_POOL_MIN=1
PARTNER_POOL_MAX=8
# Guarded SQL hatch. See docs/explain-cost-calibration.md before changing the
# ceilings -- they are derived from measured access paths, not picked.
# Refuse a query whose root plan node exceeds this EXPLAIN cost.
SQL_HATCH_MAX_PLAN_COST=5000000
# Refuse a sequential scan on a records_* relation above this cost.
SQL_HATCH_MAX_RECORDS_SEQSCAN_COST=50000
# Rows returned by one hatch query. Must be >= 1.
SQL_HATCH_MAX_ROWS=500
# Per-statement ceiling for the hatch. Must be >= 1: Postgres reads 0 as
# UNLIMITED, which would let one LLM-authored query run without bound.
SQL_HATCH_TIMEOUT_MS=20000
# Fixture DB used by the test suite.
TEST_DSN=postgresql://graph:graph@127.0.0.1:55432/graph_fixture
